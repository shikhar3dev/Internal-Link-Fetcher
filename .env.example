# Google AI Studio API Key (Get a free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local SQLite Database
DATABASE_PATH=./data/internal_linker.db

# Crawler Configuration
USER_AGENT=InternalLinkOpportunityFinder/1.0 (+https://example.com/bot)
REQUEST_TIMEOUT_SECONDS=15
REQUESTS_PER_SECOND=2